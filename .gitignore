# ──────────────────────────────────────────────
# NeighborLink AI - Git Ignore
# ──────────────────────────────────────────────

# ── Environment ──────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
venv/
.venv/
env/

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build Output ─────────────────────────────
frontend/dist/
backend/dist/

# ── IDE ──────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing ──────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── AI Models (large files) ─────────────────
*.pt
*.pth
*.onnx
*.bin
models/

# ── Docker ───────────────────────────────────
docker-compose.override.yml

# ── Logs ─────────────────────────────────────
*.log
logs/

# ── Firebase ─────────────────────────────────
firebase-service-account.json
serviceAccountKey.json

# ── Database ─────────────────────────────────
*.db
*.sqlite3
